- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='pi4_dqpsk_demod',\n            in_sig=[np.complex64],\n \
      \           out_sig=[np.uint8]\n        )\n        self.prev_sample = complex(1,\
      \ 0)\n\n    def work(self, input_items, output_items):\n        in_data = input_items[0]\n\
      \        out_data = output_items[0]\n        N = len(in_data)\n        samples\
      \ = np.concatenate([[self.prev_sample], in_data])\n        delta_phi = np.angle(samples[1:]\
      \ * np.conj(samples[:-1]))\n        self.prev_sample = in_data[-1]\n       \
      \ possible_phases = np.array([np.pi/4, 3*np.pi/4, -np.pi/4, -3*np.pi/4])\n \
      \       symbol_map = np.array([0, 1, 2, 3])\n        for i in range(N):\n  \
      \          diffs = np.abs(np.angle(np.exp(1j * (delta_phi[i] - possible_phases))))\n\
      \            out_data[i] = symbol_map[np.argmin(diffs)]\n        return N\n"
    affinity: ''
    alias: ''
    comment: Demodulateur pi/4-DQPSK
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('pi4_dqpsk_demod', 'blk', [], [('0', 'complex', 1)], [('0', 'byte',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1472, 344.0]
    rotation: 0
    state: enabled
