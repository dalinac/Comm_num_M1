connections:
- [analog_const_source_x_0, '0', blocks_stream_mux_0, '0']
- [analog_random_source_x_0, '0', digital_constellation_encoder_bc_0, '0']
- [blocks_delay_0, '0', blocks_multiply_xx_0, '1']
- [blocks_multiply_const_vxx_0, '0', blocks_stream_mux_0, '1']
- [blocks_multiply_const_vxx_0, '0', qtgui_const_sink_x_0, '0']
- [blocks_multiply_const_vxx_0_0, '0', qtgui_const_sink_x_0, '2']
- [blocks_multiply_xx_0, '0', blocks_stream_demux_0, '0']
- [blocks_stream_demux_0, '0', blocks_null_sink_0, '0']
- [blocks_stream_demux_0, '1', blocks_multiply_const_vxx_0_0, '0']
- [blocks_stream_demux_0, '1', qtgui_const_sink_x_0, '1']
