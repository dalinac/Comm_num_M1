    bus_structure: null
    coordinate: [840, 344.0]
    rotation: 180
    state: enabled
- name: digital_constellation_encoder_bc_0
  id: digital_constellation_encoder_bc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    constellation: my_const
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 416.0]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='my_short_to_char_unpack',  \n            in_sig=[np.int16],\n\
      \            out_sig=[(np.uint8,2)]\n        )\n\n    def work(self, input_items,\
      \ output_items):\n        input_shorts = input_items[0]\n        output = output_items[0]\
      \        \n        for i in range(len(input_shorts)):\n            val = input_shorts[i]\n\
      \            output[i][0] = (val >> 8) & 0xFF   # octet de PpF\n           \
      \ output[i][1] = val & 0xFF          # octet de PmF\n        return len(input_shorts)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('my_short_to_char_unpack', 'blk', [], [('0', 'short', 1)], [('0',
      'byte', 2)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 240.0]
    rotation: 0
    state: enabled
- name: pad_sink_0
  id: pad_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    label: out
    num_streams: '1'
    optional: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1056, 416.0]
    rotation: 0
    state: true
- name: pad_source_0
  id: pad_source
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    label: in
    maxoutbuf: '0'
    minoutbuf: '0'
    num_streams: '1'
    optional: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [72, 320.0]
    rotation: 180
    state: true
- name: samp_rate
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: ''
    short_id: ''
    type: ''
    value: '2048000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 8.0]
    rotation: 0
    state: true

connections:
- [QpiDQPSKmod_0, '0', pad_sink_0, '0']
- [blocks_complex_to_magphase_0, '0', blocks_float_to_short_0, '0']
- [blocks_complex_to_magphase_0, '1', blocks_float_to_short_0_0, '0']
- [blocks_float_to_short_0, '0', blocks_interleave_0, '0']
- [blocks_float_to_short_0_0, '0', blocks_interleave_0, '1']
- [blocks_interleave_0, '0', blocks_throttle_0, '0']
- [blocks_repack_bits_bb_0, '0', digital_constellation_encoder_bc_0, '0']
- [blocks_throttle_0, '0', epy_block_0, '0']
- [blocks_vector_to_stream_0, '0', blocks_repack_bits_bb_0, '0']
- [digital_constellation_encoder_bc_0, '0', QpiDQPSKmod_0, '0']
- [epy_block_0, '0', blocks_vector_to_stream_0, '0']
- [pad_source_0, '0', blocks_complex_to_magphase_0, '0']

