- name: digital_constellation_decoder_cb_0
  id: digital_constellation_decoder_cb
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    constellation: my_const
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 216.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='my_short_to_char_pack',\n            in_sig=[(np.uint8,2)],\n\
      \            out_sig=[np.int16]\n        )\n\n    def work(self, input_items,\
      \ output_items):\n        input_chars = input_items[0]\n        output = output_items[0]\n\
      \        for i in range(len(output)):\n            high_byte = input_chars[i][0]\n\
      \            low_byte  = input_chars[i][1]\n            output[i] = (high_byte\
      \ << 8) | low_byte\n        return len(output)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('my_short_to_char_pack', 'blk', [], [('0', 'byte', 2)], [('0', 'short',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 176.0]
    rotation: 0
    state: enabled
- name: pad_sink_3
  id: pad_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    label: out
    num_streams: '1'
    optional: 'False'
    type: complex
    vlen: '1'
