- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\nclass blk(gr.sync_block):\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='my_short_to_char_pack',\
      \ \n            in_sig=[(np.uint8, 2)], # Entr\xE9e : vecteur de 2 octets (bytes)\n\
      \            out_sig=[np.int16]      # Sortie : 1 mot de 16 bits (short)\n \
      \       )\n\n    def work(self, input_items, output_items):\n        input_chars\
      \ = input_items[0]\n        output = output_items[0]\n        \n        # On\
      \ convertit d'abord en int16 pour \xE9viter les d\xE9bordements (overflow) lors\
      \ du d\xE9calage\n        low_byte = input_chars[:, 0].astype(np.int16)  # LSB\
      \ en premier d'apr\xE8s le TP\n        high_byte = input_chars[:, 1].astype(np.int16)\
      \ # MSB en second\n        \n        # Recomposition du mot de 16 bits\n   \
      \     output[:] = (high_byte << 8) | low_byte\n        \n        return len(output)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('my_short_to_char_pack', 'blk', [], [('0', 'byte', 2)], [('0', 'short',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 608.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='my_short_to_char_unpack',\n            in_sig=[np.int16],\
      \       # Entr\xE9e : 1 mot de 16 bits (short)\n            out_sig=[(np.uint8,\
      \ 2)]  # Sortie : vecteur de 2 octets (bytes)\n        )\n\n    def work(self,\
      \ input_items, output_items):\n        in_data = input_items[0]\n        out_data\
      \ = output_items[0]\n        \n        # Masque bit-\xE0-bit pour r\xE9cup\xE9\
      rer le LSB (Octet de poids faible) en premier\n        out_data[:, 0] = (in_data\
      \ & 0xFF).astype(np.uint8) \n        \n        # D\xE9calage de 8 bits vers\
      \ la droite puis masque pour le MSB (Octet de poids fort)\n        out_data[:,\
      \ 1] = ((in_data >> 8) & 0xFF).astype(np.uint8)\n        \n        return len(out_data)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('my_short_to_char_unpack', 'blk', [], [('0', 'short', 1)], [('0',
      'byte', 2)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 224.0]
    rotation: 0
    state: enabled

