connections:
- [blocks_multiply_conjugate_cc_0_0_0, '0', blocks_stream_to_vector_0_0, '0']
- [blocks_stream_demux_0, '0', blocks_null_sink_0, '0']
- [blocks_stream_demux_0, '1', pad_sink_0_0, '0']
- [blocks_stream_to_vector_0_0, '0', epy_block_1_0, '0']
- [blocks_vector_source_x_1_0_0, '0', digital_constellation_encoder_bc_0_0_0_0_0,
  '0']
