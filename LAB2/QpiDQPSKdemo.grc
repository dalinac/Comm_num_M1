- [digital_constellation_encoder_bc_0_0_0_0_0, '0', blocks_multiply_conjugate_cc_0_0_0,
  '1']
- [epy_block_1_0, '0', blocks_vector_to_stream_0_0, '0']
- [pad_source_0_0, '0', blocks_multiply_conjugate_cc_0_0_0, '0']

